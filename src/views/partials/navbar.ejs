<!-- Top Navbar -->
<nav class="top-navbar">
  <div class="navbar-left">
    <button class="navbar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
      <i class="bi bi-list"></i>
    </button>
    <h1 class="navbar-title"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1>
  </div>

  <div class="navbar-right">
    <!-- Stok Alert Button -->
    <% if (typeof stokAlertCount !== 'undefined' && stokAlertCount > 0) { %>
    <div class="dropdown">
      <button class="navbar-icon-btn" data-bs-toggle="dropdown" aria-label="Stok alert">
        <i class="bi bi-exclamation-triangle"></i>
        <span class="badge-dot"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end stok-alert-dropdown">
        <div class="stok-alert-header">
          <i class="bi bi-exclamation-triangle-fill text-warning"></i>
          Stok Rendah (<%= stokAlertCount %> produk)
        </div>
        <% if (typeof stokAlertItems !== 'undefined') { %>
          <% stokAlertItems.forEach(function(item) { %>
            <a href="/produk/<%= item.id %>/edit" class="stok-alert-item">
              <div class="stok-alert-item-icon">
                <i class="bi bi-box-seam"></i>
              </div>
              <div class="stok-alert-item-info">
                <div class="stok-alert-item-name"><%= item.nama %></div>
                <div class="stok-alert-item-detail">Stok: <%= item.stok %> / Min: <%= item.stok_minimum %></div>
              </div>
            </a>
          <% }); %>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Notifications -->
    <button class="navbar-icon-btn" title="Notifikasi">
      <i class="bi bi-bell"></i>
    </button>

    <!-- User Dropdown -->
    <div class="dropdown">
      <button class="navbar-user-btn" data-bs-toggle="dropdown" aria-label="User menu">
        <div class="navbar-user-avatar">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama.charAt(0).toUpperCase() : 'U' %>
        </div>
        <span class="navbar-user-name"><%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'User' %></span>
        <i class="bi bi-chevron-down" style="font-size:0.65rem;color:var(--text-muted);"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end" style="border-radius:var(--radius-lg);border:1px solid var(--border-color);box-shadow:var(--shadow-lg);min-width:180px;">
        <li>
          <div class="dropdown-item-text" style="font-size:0.78rem;">
            <strong><%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'User' %></strong><br>
            <span class="text-muted"><%= (typeof user !== 'undefined' && user && user.role) ? user.role : '' %></span>
          </div>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <a class="dropdown-item" href="/pengaturan" style="font-size:0.82rem;">
            <i class="bi bi-gear me-2"></i>Pengaturan
          </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <a class="dropdown-item text-danger" href="/logout" style="font-size:0.82rem;">
            <i class="bi bi-box-arrow-right me-2"></i>Logout
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
