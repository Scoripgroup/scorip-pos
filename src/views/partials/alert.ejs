<!-- Flash Alert Messages -->
<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
  <% success_msg.forEach(function(msg) { %>
    <div class="alert-flash alert-success animate-fade-in-up" role="alert">
      <i class="bi bi-check-circle-fill"></i>
      <span><%= msg %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
  <% error_msg.forEach(function(msg) { %>
    <div class="alert-flash alert-danger animate-fade-in-up" role="alert">
      <i class="bi bi-x-circle-fill"></i>
      <span><%= msg %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>
<% } %>

<% if (typeof warning_msg !== 'undefined' && warning_msg.length > 0) { %>
  <% warning_msg.forEach(function(msg) { %>
    <div class="alert-flash alert-warning animate-fade-in-up" role="alert">
      <i class="bi bi-exclamation-triangle-fill"></i>
      <span><%= msg %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% }); %>
<% } %>
