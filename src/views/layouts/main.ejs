<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SCORIP POS — Sistem POS Kasir & PO Import Barang">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %><%= settings.nama_aplikasi || 'SCORIP POS' %></title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- POS CSS (always loaded, lightweight) -->
  <link rel="stylesheet" href="/css/pos.css">

  <!-- PWA -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#4F46E5">
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
</head>
<body<%= typeof activePage !== 'undefined' && activePage === 'pos' ? ' class="is-pos-page"' : '' %>>

  <!-- Sidebar Overlay (Mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Sidebar -->
  <%- include('../partials/sidebar', { activePage: typeof activePage !== 'undefined' ? activePage : '' }) %>

  <!-- Main Content -->
  <div class="main-content">
    <!-- Top Navbar -->
    <%- include('../partials/navbar', { title: typeof title !== 'undefined' ? title : 'Dashboard' }) %>

    <!-- Content Wrapper -->
    <div class="content-wrapper<%= typeof activePage !== 'undefined' && activePage === 'pos' ? ' pos-content-wrapper' : '' %>">
      <!-- Flash Messages -->
      <%- include('../partials/alert') %>

      <!-- Page Body -->
      <%- body %>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <%- include('../partials/delete-modal') %>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Global JS -->
  <script src="/js/app.js"></script>
</body>
</html>
