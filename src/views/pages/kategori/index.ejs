<!-- Manajemen Kategori -->
<div class="animate-fade-in-up">
  <div class="page-header">
    <div class="page-header-left">
      <h2 class="page-title">Manajemen Kategori</h2>
      <span class="page-subtitle"><%= kategori.length %> kategori terdaftar</span>
    </div>
    <div class="page-header-actions">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#kategoriModal" onclick="resetKategoriForm()">
        <i class="bi bi-plus-lg"></i> Tambah Kategori
      </button>
    </div>
  </div>

  <div class="table-wrapper" style="max-width: 900px;">
    <table class="data-table">
      <thead>
        <tr>
          <th class="text-nowrap" style="width:60px;">#</th>
          <th>Nama Kategori</th>
          <th class="text-center text-nowrap" style="width:160px;">Jumlah Produk</th>
          <th class="text-end text-nowrap" style="width:120px;">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% kategori.forEach(function(k, i) { %>
        <tr>
          <td style="color:var(--text-muted);font-size:0.82rem;"><%= i + 1 %></td>
          <td style="font-weight:550;">
            <i class="bi bi-tag me-2" style="color:var(--primary);"></i><%= k.nama %>
          </td>
          <td class="text-center text-nowrap">
            <span style="background:var(--primary-bg);color:var(--primary);padding:0.2rem 0.6rem;border-radius:var(--radius-full);font-size:0.78rem;font-weight:600;">
              <%= k.jumlah_produk %>
            </span>
          </td>
          <td class="text-end">
            <div class="d-flex justify-content-end gap-1">
              <button class="btn btn-ghost btn-icon btn-sm" title="Edit"
                      data-bs-toggle="modal" data-bs-target="#kategoriModal"
                      onclick="editKategori(<%= k.id %>, '<%= k.nama %>')">
                <i class="bi bi-pencil"></i>
              </button>
              <button class="btn btn-ghost btn-icon btn-sm" title="Hapus"
                      data-bs-toggle="modal" data-bs-target="#deleteModal"
                      data-name="Kategori: <%= k.nama %>" data-url="/kategori/<%= k.id %>">
                <i class="bi bi-trash3"></i>
              </button>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- Kategori Modal -->
<div class="modal fade" id="kategoriModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="kategoriModalTitle">Tambah Kategori</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/kategori" method="POST" id="kategoriForm">
        <div class="modal-body">
          <input type="hidden" name="_method" id="kategoriMethod" value="POST">
          <label class="form-label">Nama Kategori <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="nama" id="kategoriNama" required autofocus placeholder="Contoh: Elektronik">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i> Simpan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function resetKategoriForm() {
  document.getElementById('kategoriModalTitle').textContent = 'Tambah Kategori';
  document.getElementById('kategoriForm').action = '/kategori';
  document.getElementById('kategoriMethod').value = 'POST';
  document.getElementById('kategoriNama').value = '';
}

function editKategori(id, nama) {
  document.getElementById('kategoriModalTitle').textContent = 'Edit Kategori';
  document.getElementById('kategoriForm').action = '/kategori/' + id;
  document.getElementById('kategoriMethod').value = 'PUT';
  document.getElementById('kategoriNama').value = nama;
}
</script>
