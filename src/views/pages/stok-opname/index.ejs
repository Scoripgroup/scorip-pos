<!-- Stok Opname List -->
<div class="animate-fade-in-up">
  <div class="page-header">
    <div class="page-header-left">
      <h2 class="page-title">Stok Opname</h2>
      <span class="page-subtitle">Riwayat pengecekan stok fisik</span>
    </div>
    <div class="page-header-actions">
      <a href="/stok-opname/baru" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Opname Baru</a>
    </div>
  </div>

  <div class="table-wrapper">
    <div class="table-header">
      <div class="table-actions">
        <div class="table-search">
          <i class="bi bi-search"></i>
          <input type="text" placeholder="Cari produk...">
        </div>
        <input type="date" class="form-control form-control-sm" style="width:auto;font-size:0.82rem;">
      </div>
    </div>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Tanggal</th>
            <th>SKU</th>
            <th>Produk</th>
            <th class="text-center">Stok Sistem</th>
            <th class="text-center">Stok Fisik</th>
            <th class="text-center">Selisih</th>
            <th>User</th>
            <th>Catatan</th>
            <th style="width:60px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% opname.forEach(function(o) { %>
          <tr>
            <td style="font-size:0.8rem;color:var(--text-secondary);">
              <%= new Date(o.tanggal).toLocaleDateString('id-ID', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
            </td>
            <td style="font-family:var(--font-mono);font-size:0.78rem;"><%= o.sku %></td>
            <td style="font-weight:550;"><%= o.produk %></td>
            <td class="text-center"><%= o.stok_sistem %></td>
            <td class="text-center"><%= o.stok_fisik %></td>
            <td class="text-center">
              <% if (o.selisih < 0) { %>
                <span style="color:var(--danger);font-weight:600;"><%= o.selisih %></span>
              <% } else if (o.selisih > 0) { %>
                <span style="color:var(--success);font-weight:600;">+<%= o.selisih %></span>
              <% } else { %>
                <span style="color:var(--text-muted);">0</span>
              <% } %>
            </td>
            <td style="font-size:0.82rem;"><%= o.user %></td>
            <td style="font-size:0.78rem;color:var(--text-secondary);max-width:200px;" class="truncate"><%= o.catatan || '-' %></td>
            <td>
              <button class="btn btn-ghost btn-icon btn-sm" title="Hapus"
                      data-bs-toggle="modal" data-bs-target="#deleteModal"
                      data-name="Opname <%= o.produk %>" data-url="/stok-opname/<%= o.id %>">
                <i class="bi bi-trash3"></i>
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="table-footer">
      <span class="table-info">Menampilkan <%= opname.length %> data opname</span>
      <%- include('../../partials/pagination', { page: 1, pages: 1, url: '/stok-opname' }) %>
    </div>
  </div>
</div>
